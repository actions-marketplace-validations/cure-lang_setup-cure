{
  "name": "setup-cure",
  "version": "1.0.2",
  "description": "GitHub Action to set up the Cure programming language",
  "main": "dist/index.js",
  "scripts": {
    "build": "esbuild src/index.js --bundle --format=cjs --platform=node --target=node20 --outfile=dist/index.js",
    "test": "node dist/index.js"
  },
  "keywords": [
    "github-actions",
    "cure",
    "cure-lang",
    "setup",
    "beam",
    "elixir"
  ],
  "author": "Cure Language Team",
  "license": "MIT",
  "dependencies": {
    "@actions/core": "^1.11.1",
    "@actions/exec": "^1.1.1",
    "@actions/http-client": "^2.2.3",
    "@actions/io": "^1.1.3",
    "@actions/tool-cache": "^2.0.1"
  },
  "devDependencies": {
    "@vercel/ncc": "^0.38.3",
    "esbuild": "^0.28.2"
  }
}
